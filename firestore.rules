rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Products: public read only for published, full access for authenticated users (admins)
    match /products/{productId} {
      allow read: if resource.data.status == "published" || request.auth != null;
      allow create, update, delete: if request.auth != null;
    }

    // Blog posts: public read only for published, full access for authenticated users (admins)
    match /blogPosts/{postId} {
      allow read: if resource.data.status == "published" || request.auth != null;
      allow create, update, delete: if request.auth != null;
    }

    // Default: deny writes, allow reads only to authenticated users for other collections
    match /{document=**} {
      allow read: if request.auth != null;
      allow write: if false;
    }
  }
}
