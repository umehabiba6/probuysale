rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: check that the authenticated user is an admin (admins/{uid}.role == 'admin')
    function isAdmin() {
      return request.auth != null &&
        get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role == 'admin';
    }

    // Products: public read only for published, writes only for admins
    match /products/{productId} {
      allow read: if resource.data.status == "published" || request.auth != null;
      allow create, update, delete: if isAdmin();
    }

    // Blog posts: public read only for published, writes only for admins
    match /blogPosts/{postId} {
      allow read: if resource.data.status == "published" || request.auth != null;
      allow create, update, delete: if isAdmin();
    }

    // Admins collection: only existing admins may read/write their own record
    match /admins/{adminId} {
      allow read: if isAdmin() || (request.auth != null && request.auth.uid == adminId);
      allow write: if isAdmin();
    }

    // Default: deny writes, allow reads only to authenticated users for other collections
    match /{document=**} {
      allow read: if request.auth != null;
      allow write: if false;
    }
  }
}
